# Скопируй этот файл в .env и заполни. .env в git не попадает.

# ID твоего Threads-аккаунта (число). Получим на шаге настройки.
THREADS_USER_ID=

# Долгоживущий access token (60 дней). Получим на шаге настройки.
THREADS_ACCESS_TOKEN=

# App secret из настроек приложения Meta — нужен только для обмена/продления токена.
THREADS_APP_SECRET=

# true  = ничего реально не постит, только печатает что улетело бы
# false = постит по-настоящему
DRY_RUN=true
